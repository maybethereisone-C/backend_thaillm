# --- Required ---
LLM_BACKEND=openai_compatible
LLM_UPSTREAM_BASE_URL=https://upstream.example.com/v1
LLM_UPSTREAM_API_KEY=your-upstream-api-key-here

# --- Model ---
LLM_MODEL_ID=your-model-id

# --- Gateway Auth (set before exposing to the internet) ---
LLM_API_KEYS=change-me-key-1,change-me-key-2

# --- Security ---
LLM_TRUSTED_HOSTS=your-domain.com
LLM_ALLOWED_ORIGINS=https://your-frontend.com

# --- Inference ---
LLM_MAX_TOKENS_DEFAULT=512
LLM_PROMPT_GUARD_ENABLED=true
