# --- Competition endpoint ---
LLM_THAILLM_BASE_URL=https://your-thaillm-host/v1
LLM_THAILLM_MODEL_ID=your-model-id
LLM_THAILLM_API_KEY=your-api-key

# --- Security (set before exposing to the internet) ---
LLM_TRUSTED_HOSTS=your-domain.com
LLM_ALLOWED_ORIGINS=https://your-frontend.com

# --- Server ---
# Container listen port.
PORT=8000

# --- Agent paths (bundled defaults shown; override only if not using Docker) ---
LLM_AGENT_SRC_PATH=/agent/src
LLM_AGENT_DB_PATH=/data/agent.duckdb
LLM_AUDIT_TRAIL_DIR=/data/audit_trails
