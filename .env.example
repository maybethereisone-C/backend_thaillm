# --- Required ---
THAILLM_BACKEND=openai_compatible
THAILLM_UPSTREAM_BASE_URL=http://thaillm.or.th/api/v1
THAILLM_UPSTREAM_API_KEY=your-upstream-api-key-here

# --- Model ---
THAILLM_MODEL_ID=typhoon-s-thaillm-8b-instruct

# --- Gateway Auth (set before exposing to internet) ---
THAILLM_API_KEYS=change-me-key-1,change-me-key-2

# --- Security ---
THAILLM_TRUSTED_HOSTS=your-domain.com
THAILLM_ALLOWED_ORIGINS=https://your-frontend.com
THAILLM_REQUEST_BODY_LIMIT_BYTES=65536
THAILLM_RATE_LIMIT_PER_MINUTE=60

# --- Inference Limits ---
THAILLM_MAX_TOKENS_DEFAULT=512
THAILLM_MAX_TOKENS_LIMIT=2048
THAILLM_PROMPT_GUARD_ENABLED=true
THAILLM_PROMPT_MAX_CHARS=20000
THAILLM_RESPONSE_TEXT_LIMIT_CHARS=20000

# --- MCP ---
THAILLM_MCP_ENABLED=true
THAILLM_MCP_MANIFEST_SIGNING_KEY=your-hmac-signing-key-here
